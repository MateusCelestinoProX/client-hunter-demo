# ===========================================================================
# Client Hunter PRO · Versão de Demonstração (Demo Showcase)
# ===========================================================================
#
# NOTA DE DEMONSTRAÇÃO:
# Esta versão demo funciona 100% "out-of-the-box" sem nenhuma variável necessária!
# Caso nenhuma chave seja fornecida, o sistema opera automaticamente no
# Modo Demonstração Interativo com dados mock enterprise completos.
#
# Se desejar conectar um cluster real em produção, preencha os campos abaixo:

# 1. Apify API (Opcional - para scraping real via atores externos)
APIFY_TOKEN=

# 2. Banco de Dados PostgreSQL / Supabase (Opcional - em branco usa Mock/SQLite local)
SUPABASE_DB_URL=

# 3. Google Places API New (Opcional)
GOOGLE_PLACES_API_KEY=

# 4. Serper API (Opcional)
SERPER_API_KEY=

# 5. Modo de Operação
# DEMO_MODE=true
